{
  "name": "@agi-fans/dsh-tui",
  "description": "Cordis plugin suite for omdsh terminal presentation, session interaction, commands, and human input",
  "version": "0.3.0",
  "homepage": "https://github.com/agi-fans/oh-my-dsh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agi-fans/oh-my-dsh.git",
    "directory": "packages/tui/omdsh-tui"
  },
  "bugs": {
    "url": "https://github.com/agi-fans/oh-my-dsh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/runner.d.ts",
      "default": "./lib/runner.js"
    },
    "./definition": {
      "types": "./lib/definition.d.ts",
      "default": "./lib/definition.js"
    },
    "./provider-local": {
      "types": "./lib/provider-local.d.ts",
      "default": "./lib/provider-local.js"
    },
    "./session-runtime": {
      "types": "./lib/session-runtime.d.ts",
      "default": "./lib/session-runtime.js"
    },
    "./human-interaction": {
      "types": "./lib/human-interaction.d.ts",
      "default": "./lib/human-interaction.js"
    },
    "./tool-presentation": {
      "types": "./lib/tool-presentation.d.ts",
      "default": "./lib/tool-presentation.js"
    },
    "./command-session": {
      "types": "./lib/command-session.d.ts",
      "default": "./lib/command-session.js"
    },
    "./command-steer": {
      "types": "./lib/command-steer.d.ts",
      "default": "./lib/command-steer.js"
    },
    "./command-model": {
      "types": "./lib/command-model.d.ts",
      "default": "./lib/command-model.js"
    },
    "./command-permission": {
      "types": "./lib/command-permission.d.ts",
      "default": "./lib/command-permission.js"
    },
    "./command-auth": {
      "types": "./lib/command-auth.d.ts",
      "default": "./lib/command-auth.js"
    },
    "./command-export": {
      "types": "./lib/command-export.d.ts",
      "default": "./lib/command-export.js"
    },
    "./command-integrations": {
      "types": "./lib/command-integrations.d.ts",
      "default": "./lib/command-integrations.js"
    },
    "./startup-notices": {
      "types": "./lib/startup-notices.d.ts",
      "default": "./lib/startup-notices.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('lib',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b tsconfig.json && node ../../../scripts/copy-changelog.mjs lib/CHANGELOG.md",
    "test": "vitest run src",
    "typecheck": "tsc -b tsconfig.json",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-default-model": "0.1.0-rc.6",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-permission-presets": "0.1.0-rc.6",
    "@deepseek-ai/dsh-plan-mode": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-query": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-stats": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title": "0.1.0-rc.6",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-token-meter": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
