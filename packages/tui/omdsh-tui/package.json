{
  "name": "@agi-fans/dsh-tui",
  "description": "Library-only Cordis plugin suite for DeepSeek Harness terminal presentation and interaction",
  "version": "0.19.0",
  "homepage": "https://omdsh.agi.fans/",
  "keywords": [
    "omdsh",
    "oh-my-dsh",
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "tui",
    "cordis",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agi-fans/oh-my-dsh.git",
    "directory": "packages/tui/omdsh-tui"
  },
  "bugs": {
    "url": "https://github.com/agi-fans/oh-my-dsh/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/runtime/runner.d.ts",
      "default": "./lib/runtime/runner.js"
    },
    "./definition": {
      "types": "./lib/definition.d.ts",
      "default": "./lib/definition.js"
    },
    "./provider-local": {
      "types": "./lib/runtime/provider-local.d.ts",
      "default": "./lib/runtime/provider-local.js"
    },
    "./session-runtime": {
      "types": "./lib/runtime/session-runtime.d.ts",
      "default": "./lib/runtime/session-runtime.js"
    },
    "./human-interaction": {
      "types": "./lib/runtime/human-interaction.d.ts",
      "default": "./lib/runtime/human-interaction.js"
    },
    "./tool-presentation": {
      "types": "./lib/runtime/tool-presentation.d.ts",
      "default": "./lib/runtime/tool-presentation.js"
    },
    "./agent-profile": {
      "types": "./lib/runtime/agent-profile.d.ts",
      "default": "./lib/runtime/agent-profile.js"
    },
    "./command-session": {
      "types": "./lib/commands/session.d.ts",
      "default": "./lib/commands/session.js"
    },
    "./command-session-configuration": {
      "types": "./lib/commands/session-configuration.d.ts",
      "default": "./lib/commands/session-configuration.js"
    },
    "./command-steer": {
      "types": "./lib/commands/steer.d.ts",
      "default": "./lib/commands/steer.js"
    },
    "./command-loop": {
      "types": "./lib/commands/loop.d.ts",
      "default": "./lib/commands/loop.js"
    },
    "./command-model": {
      "types": "./lib/commands/model.d.ts",
      "default": "./lib/commands/model.js"
    },
    "./command-permission": {
      "types": "./lib/commands/permission.d.ts",
      "default": "./lib/commands/permission.js"
    },
    "./command-jobs": {
      "types": "./lib/commands/jobs.d.ts",
      "default": "./lib/commands/jobs.js"
    },
    "./command-auth": {
      "types": "./lib/commands/auth.d.ts",
      "default": "./lib/commands/auth.js"
    },
    "./command-diff": {
      "types": "./lib/commands/diff.d.ts",
      "default": "./lib/commands/diff.js"
    },
    "./command-export": {
      "types": "./lib/commands/export.d.ts",
      "default": "./lib/commands/export.js"
    },
    "./command-trajectory": {
      "types": "./lib/commands/trajectory.d.ts",
      "default": "./lib/commands/trajectory.js"
    },
    "./command-integrations": {
      "types": "./lib/commands/integrations.d.ts",
      "default": "./lib/commands/integrations.js"
    },
    "./startup-notices": {
      "types": "./lib/runtime/startup-notices.d.ts",
      "default": "./lib/runtime/startup-notices.js"
    },
    "./package.json": "./package.json",
    "./command-plugins": {
      "types": "./lib/commands/plugins.d.ts",
      "default": "./lib/commands/plugins.js"
    },
    "./subagent-model-selection": {
      "types": "./lib/runtime/subagent-model-selection.d.ts",
      "default": "./lib/runtime/subagent-model-selection.js"
    },
    "./command-terminal": {
      "types": "./lib/commands/terminal.d.ts",
      "default": "./lib/commands/terminal.js"
    },
    "./command-files": {
      "types": "./lib/commands/files.d.ts",
      "default": "./lib/commands/files.js"
    },
    "./hook-settings": {
      "types": "./lib/runtime/hook-settings.d.ts",
      "default": "./lib/runtime/hook-settings.js"
    }
  },
  "files": [
    "lib/**/*"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('lib',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build": "tsc -b tsconfig.json && node ../../../scripts/copy-changelog.mjs lib/CHANGELOG.md",
    "test": "vitest run src",
    "typecheck": "tsc -b tsconfig.json",
    "prepack": "node ../../../scripts/sync-package-readme.mjs --check && pnpm run clean && pnpm run build"
  },
