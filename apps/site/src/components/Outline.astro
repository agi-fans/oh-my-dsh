---
import type { MarkdownHeading } from 'astro'
import { ui, type Locale } from '../i18n'

interface Props {
  locale: Locale
  headings: MarkdownHeading[]
}

const { locale, headings } = Astro.props
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <nav class="outline" aria-label={ui[locale].outline} data-pagefind-ignore>
      <h2 class="outline-heading">{ui[locale].outline}</h2>
      {items.map((h) => (
        <a href={`#${h.slug}`} class:list={[{ 'depth-3': h.depth === 3 }]}>
          {h.text}
        </a>
      ))}
    </nav>
  )
}
