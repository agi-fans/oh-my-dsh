---
import type { MarkdownHeading } from 'astro'
import { ui, type Locale } from '../i18n'

interface Props {
  locale: Locale
  headings: MarkdownHeading[]
}

const { locale, headings } = Astro.props
const items = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

{
  items.length > 0 && (
    <nav class="outline" aria-label={ui[locale].outline} data-pagefind-ignore>
      <h2 class="outline-heading">{ui[locale].outline}</h2>
      {items.map((h) => (
        <a href={`#${h.slug}`} class:list={[{ 'depth-3': h.depth === 3 }]}>
          {h.text}
        </a>
      ))}
    </nav>
  )
}

<script>
  const outlineLinks = [...document.querySelectorAll<HTMLAnchorElement>('.outline a[href^="#"]')]
  if (outlineLinks.length > 0) {
    const byId = new Map<string, HTMLAnchorElement>()
    for (const link of outlineLinks) {
      byId.set(decodeURIComponent(link.hash.slice(1)), link)
    }
    const headings = [...document.querySelectorAll<HTMLElement>('.doc-body h2[id], .doc-body h3[id]')]
    let activeLink: HTMLAnchorElement | null = null
    const setActive = (id: string) => {
      const next = byId.get(id) ?? null
      if (next === activeLink) return
      activeLink?.classList.remove('active')
      next?.classList.add('active')
      activeLink = next
    }
    let ticking = false
    const update = () => {
      ticking = false
      const y = window.scrollY + 96
      let current: HTMLElement | undefined = headings[0]
      for (const h of headings) {
        if (h.offsetTop <= y) current = h
      }
      if (current) setActive(current.id)
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(update)
        }
      },
      { passive: true },
    )
    update()
  }
</script>
