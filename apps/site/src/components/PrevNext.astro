---
import { docOrder, docsHref, label } from '../nav'
import { ui, type Locale } from '../i18n'

interface Props {
  locale: Locale
  current: string
}

const { locale, current } = Astro.props
const index = docOrder.findIndex((entry) => entry.slug === current)
const prev = index > 0 ? docOrder[index - 1] : null
const next = index >= 0 && index < docOrder.length - 1 ? docOrder[index + 1] : null
const t = ui[locale]
---

<nav class="prevnext" data-pagefind-ignore>
  {
    prev ? (
      <a class="prev" href={docsHref(prev.slug, locale)}>
        <span class="pn-label">← {t.previous}</span>
        <span class="pn-title">{label(prev, locale)}</span>
      </a>
    ) : (
      <span class="placeholder" />
    )
  }
  {
    next ? (
      <a class="next" href={docsHref(next.slug, locale)}>
        <span class="pn-label">{t.next} →</span>
        <span class="pn-title">{label(next, locale)}</span>
      </a>
    ) : (
      <span class="placeholder" />
    )
  }
</nav>
