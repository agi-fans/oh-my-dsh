---
interface Props {
  version: string
}

const { version } = Astro.props
const samplePrompt = 'Hello, Oh My DSH!'
const thinking = 'The user is saying hello. This is a casual greeting, so no tools are needed.'
const answer = 'Hello! Welcome to Oh My DSH. Tell me what you’d like to build, fix, or explore.'

// Exact DEEPSEEK_LOGO 20×6 Braille bitmap and GRADIENT_STOPS from
// packages/tui/omdsh-tui/src/chrome/theme.ts, decoded into vector dots so
// browsers never suffer Braille fallback font stretching or inter-cell gaps.
const DEEPSEEK_LOGO = [
  '         ⢀⣀  ⢀⡀     ',
  '⢀⣤⣶⣿⣿⣿⣿⣿⣿⣿⣧⣄⡀⢻⣿⣷⣶⣶⣶⡿',
  '⣿⡟⠛⠛⠛⠿⢿⣿⣿⣿⣿⡿⢿⣷⣾⣿⣿⠉⠉ ',
  '⢻⣿⣄⡀  ⢀⠈⠛⢿⣿⣿⣶⣿⣿⡿⠃   ',
  ' ⠙⠻⢿⣶⣦⣼⣿⣷⣦⣭⣿⠿⣿⣷⠦    ',
  '     ⠉⠉⠉⠉⠉⠁         ',
] as const

const GRADIENT_STOPS: ReadonlyArray<readonly [number, number, number]> = [
  [47, 73, 224],
  [77, 107, 254],
  [53, 200, 222],
  [124, 231, 242],
]

const BRAILLE_BITS: ReadonlyArray<readonly [number, number, number]> = [
  [0x01, 0, 0],
  [0x02, 0, 1],
  [0x04, 0, 2],
  [0x08, 1, 0],
  [0x10, 1, 1],
  [0x20, 1, 2],
  [0x40, 0, 3],
  [0x80, 1, 3],
]

function gradientColor(t: number): string {
  const seg = Math.max(0, Math.min(1, t)) * (GRADIENT_STOPS.length - 1)
  const i = Math.min(GRADIENT_STOPS.length - 2, Math.floor(seg))
  const f = seg - i
  const a = GRADIENT_STOPS[i]!
  const b = GRADIENT_STOPS[i + 1] ?? a
  const r = Math.round(a[0] + (b[0] - a[0]) * f)
  const g = Math.round(a[1] + (b[1] - a[1]) * f)
  const bl = Math.round(a[2] + (b[2] - a[2]) * f)
  return `rgb(${r} ${g} ${bl})`
}

const rows = DEEPSEEK_LOGO.length
const cols = Math.max(...DEEPSEEK_LOGO.map((line) => line.length))
const span = Math.max(1, cols + rows - 1)
const dotPitchX = 5
const dotPitchY = 6.2 // 1.24 vertical aspect ratio matches real terminal cell proportions
const dotRadius = 2.05
const svgWidth = cols * 2 * dotPitchX
const svgHeight = rows * 4 * dotPitchY

const logoDots: Array<{ cx: number; cy: number; fill: string }> = []
for (let y = 0; y < rows; y += 1) {
  const line = DEEPSEEK_LOGO[y]!
  for (let x = 0; x < line.length; x += 1) {
    const code = line.charCodeAt(x)
    if (code < 0x2800 || code > 0x28ff) continue
    const bits = code - 0x2800
    const fill = gradientColor((x + (rows - 1 - y)) / span)
    for (const [mask, dx, dy] of BRAILLE_BITS) {
      if ((bits & mask) === 0) continue
      logoDots.push({
        cx: (x * 2 + dx + 0.5) * dotPitchX,
        cy: (y * 4 + dy + 0.5) * dotPitchY,
        fill,
      })
    }
  }
}

const drivingChars = Array.from('Deep Driving')
---

<div class="terminal-demo" data-terminal-demo aria-hidden="true">
  <div class="td-chrome">
    <i class="td-dot td-dot-red"></i>
    <i class="td-dot td-dot-yellow"></i>
    <i class="td-dot td-dot-green"></i>
  </div>
  <div class="td-screen">
    <section class="td-header">
      <svg
        class="td-logo"
        viewBox={`0 0 ${svgWidth} ${svgHeight}`}
        width={svgWidth}
        height={svgHeight}
        fill="none"
      >
        {logoDots.map((dot) => <circle cx={dot.cx} cy={dot.cy} r={dotRadius} fill={dot.fill} />)}
      </svg>
      <div class="td-wordmark">
        <span class="td-name">Oh-My-DSH <em>v{version}</em></span>
        <span class="td-slogan">Into the Unknown</span>
      </div>
    </section>

    <div class="td-transcript">
      <div class="td-user-message" data-td-user hidden></div>
      <div class="td-response" data-td-response></div>
    </div>

    <div class="td-editor" data-td-editor>
      <div class="td-rule">
        <span class="td-editor-cap td-editor-left" data-td-idle-cap>🐳</span>
        <span class="td-editor-cap td-editor-left td-activity" data-td-activity-cap hidden>
          <span class="td-spinner" data-td-spinner>⠋</span>
          <span class="td-shimmer" data-td-shimmer>
            {drivingChars.map((ch) => <span class="td-shimmer-ch">{ch === ' ' ? '\u00a0' : ch}</span>)}
          </span>
        </span>
        <span class="td-editor-cap td-access">workspace write</span>
      </div>
      <div class="td-input">
        <span data-td-prompt></span><i class="td-caret" data-td-caret></i><span class="td-placeholder" data-td-placeholder>Ask anything</span>
      </div>
      <div class="td-rule td-rule-foot"></div>
    </div>

    <footer class="td-footer">
      <div class="td-footer-row">
        <span>
          <span class="td-f-text">deepseek-flash</span><span class="td-f-sep"> · </span><span class="td-f-token">high</span><span class="td-f-sep"> · </span><span class="td-f-accent">standard</span>
        </span>
        <span class="td-f-right">
          <span class="td-f-muted">~/Workspace/oh-my-dsh</span><span class="td-f-sep"> · </span><span class="td-f-muted">main</span>
        </span>
      </div>
      <div class="td-footer-row" data-td-telemetry-idle>
        <span>
          <span class="td-f-muted">Ctx </span><span class="td-f-token">0%</span>
        </span>
        <span></span>
      </div>
      <div class="td-footer-row" data-td-telemetry-settled hidden>
        <span>
          <span class="td-f-muted">Ctx </span><span class="td-f-token">1%</span><span class="td-f-sep"> · </span><span class="td-f-muted">Cache </span><span class="td-f-positive">99%</span>
        </span>
        <span class="td-f-right">
          <span class="td-f-muted">TTFT </span><span class="td-f-text">0.9s</span><span class="td-f-sep"> · </span><span class="td-f-text">97 tok/s</span>
        </span>
      </div>
    </footer>
  </div>
</div>

<script
  is:inline
  define:vars={{ samplePrompt, thinking, answer }}
>
  const root = document.querySelector('[data-terminal-demo]')
  if (root) {
    const editorEl = root.querySelector('[data-td-editor]')
    const idleCapEl = root.querySelector('[data-td-idle-cap]')
    const activityCapEl = root.querySelector('[data-td-activity-cap]')
    const spinnerEl = root.querySelector('[data-td-spinner]')
    const shimmerChars = Array.from(root.querySelectorAll('.td-shimmer-ch'))
    const promptEl = root.querySelector('[data-td-prompt]')
    const placeholderEl = root.querySelector('[data-td-placeholder]')
    const userEl = root.querySelector('[data-td-user]')
    const responseEl = root.querySelector('[data-td-response]')
    const caretEl = root.querySelector('[data-td-caret]')
    const telemetryIdleEl = root.querySelector('[data-td-telemetry-idle]')
    const telemetrySettledEl = root.querySelector('[data-td-telemetry-settled]')
    const spinnerFrames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    const timers = []
    let spinnerTimer = null
    let spinnerFrame = 0
    let stopped = false

    const later = (fn, delay) => {
      const id = setTimeout(() => {
        if (!stopped) fn()
      }, delay)
      timers.push(id)
    }

    const paintShimmer = (frame) => {
      const runway = 3
      const highlight = (frame % (shimmerChars.length + runway * 2)) - runway
      shimmerChars.forEach((el, idx) => {
        if (el.textContent === '\u00a0') return
        const dist = Math.abs(idx - highlight)
        el.dataset.s = dist === 0 ? '0' : dist === 1 ? '1' : dist === 2 ? '2' : ''
      })
    }

    const setRunning = (running) => {
      editorEl.dataset.running = running ? 'true' : 'false'
      idleCapEl.hidden = running
      activityCapEl.hidden = !running
      if (spinnerTimer !== null) {
        clearInterval(spinnerTimer)
        spinnerTimer = null
      }
      if (running) {
        spinnerFrame = 0
        spinnerEl.textContent = spinnerFrames[0]
        paintShimmer(0)
        spinnerTimer = setInterval(() => {
          spinnerFrame += 1
          spinnerEl.textContent = spinnerFrames[spinnerFrame % spinnerFrames.length]
          paintShimmer(spinnerFrame)
        }, 90)
      }
    }

    const showSettled = () => {
      setRunning(false)
      promptEl.textContent = ''
      placeholderEl.textContent = 'Ask anything'
      placeholderEl.hidden = false
      caretEl.hidden = false
      userEl.hidden = false
      userEl.textContent = samplePrompt
      responseEl.innerHTML =
        `<div class="td-summary"><span class="td-disclosure">▸</span> <span class="td-dim">Worked for 2s · Ctrl+O to expand</span></div><div class="td-answer">${answer}</div>`
      telemetryIdleEl.hidden = true
      telemetrySettledEl.hidden = false
    }

    const typePrompt = (index = 0) => {
      if (index === 0) {
        placeholderEl.hidden = true
      }
      if (index >= samplePrompt.length) {
        later(runTurn, 420)
        return
      }
      promptEl.textContent += samplePrompt[index]
      later(() => typePrompt(index + 1), 36)
    }

    const runTurn = () => {
      userEl.hidden = false
      userEl.textContent = promptEl.textContent
      promptEl.textContent = ''
      placeholderEl.textContent = 'Enter: Queue · Alt+S: Steer'
      placeholderEl.hidden = false
      setRunning(true)
      responseEl.innerHTML = `<div class="td-dim">▸ Thinking · ${thinking}</div>`
      later(showSettled, 1350)
      later(resetDemo, 6800)
    }

    const resetDemo = () => {
      setRunning(false)
      promptEl.textContent = ''
      placeholderEl.textContent = 'Ask anything'
      placeholderEl.hidden = false
      caretEl.hidden = false
      userEl.hidden = true
      userEl.textContent = ''
      responseEl.innerHTML = ''
      telemetryIdleEl.hidden = false
      telemetrySettledEl.hidden = true
      later(() => typePrompt(), 750)
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      showSettled()
    } else if ('requestIdleCallback' in window) {
      requestIdleCallback(() => later(() => typePrompt(), 450), { timeout: 2500 })
    } else {
      later(() => typePrompt(), 850)
    }
  }
</script>

<style>
/* Semantic tokens mirror DARK_PALETTE (Catppuccin Mocha) and LIGHT_PALETTE
 * (Catppuccin Latte) in packages/tui/omdsh-tui/src/chrome/theme.ts. */
.terminal-demo {
  --td-bg: #181825;
  --td-frame-border: #2a2c3d;
  --td-text: #cdd6f4;
  --td-muted: #bac2de;
  --td-dim: #9399b2;
  --td-accent: #89b4fa;
  --td-border: #454e70;
  --td-success: #a6e3a1;
  --td-token: #cba6f7;
  --td-user-bg: #20283f;
  --td-user-text: #cdd6f4;
  --td-shadow: 0 26px 72px rgb(0 0 0 / 46%);

  width: min(760px, 100%);
  margin: 0 auto;
  overflow: hidden;
  color: var(--td-text);
  background: var(--td-bg);
  border: 1px solid var(--td-frame-border);
  border-radius: 14px;
  box-sizing: border-box;
  box-shadow: var(--td-shadow);
  font-family: var(--font-mono);
  font-size: 11px;
  line-height: 1.48;
  text-align: left;
}

:global([data-theme='light']) .terminal-demo {
  --td-bg: #eff1f5;
  --td-frame-border: #ccd0da;
  --td-text: #4c4f69;
  --td-muted: #5c5f77;
  --td-dim: #6c6f85;
  --td-accent: #245ac7;
  --td-border: #a0adca;
  --td-success: #386b35;
  --td-token: #783ab0;
  --td-user-bg: #e6ecfb;
  --td-user-text: #4c4f69;
  --td-shadow: 0 22px 60px rgb(28 36 56 / 14%);
}

.td-chrome {
  display: flex;
  gap: 7px;
  align-items: center;
  height: 28px;
  padding: 0 12px;
  background: var(--td-bg);
}

.td-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.td-dot-red { background: #ff5f57; }
.td-dot-yellow { background: #febc2e; }
.td-dot-green { background: #28c840; }

.td-screen { padding: 8px 12px 10px; }

/* Startup lockup mirrors renderWelcome in packages/tui/omdsh-tui/src/chrome/box.ts. */
.td-header {
  display: flex;
  gap: 3ch;
  align-items: center;
  padding: 2px 0 0 1ch;
}

.td-logo {
  display: block;
  width: 116px;
  height: auto;
  flex: none;
}

.td-wordmark {
  display: grid;
  gap: 1px;
  min-width: 0;
}

.td-name {
  color: var(--td-text);
  font-weight: 700;
}

.td-name em {
  color: var(--td-dim);
  font-style: normal;
  font-weight: 400;
}

.td-slogan { color: var(--td-muted); }

.td-transcript {
  min-height: 158px;
  padding: 16px 0 18px;
}

/* Full-bleed user message slab mirrors userBubble in transcript-render.ts. */
.td-user-message {
  margin-bottom: 14px;
  padding: 10px 2ch;
  color: var(--td-user-text);
  background: var(--td-user-bg);
}

.td-response {
  display: grid;
  gap: 10px;
  padding: 0 2ch;
}

.td-response :global(.td-dim) { color: var(--td-dim); }
.td-response :global(.td-disclosure) { color: var(--td-text); }
.td-response :global(.td-answer) { color: var(--td-text); }

/*
 * Top/bottom ruled composer mirrors renderEditor in box.ts: idle shows the 🐳
 * label and green workspace-write badge; active turns swap to accent rules and
 * the shimmering Deep Driving spinner.
 */
.td-editor {
  position: relative;
  color: var(--td-text);
}

.td-rule {
  position: relative;
  height: 0;
  border-top: 1px solid var(--td-border);
  transition: border-color 140ms ease;
}

.td-editor[data-running='true'] .td-rule {
  border-top-color: var(--td-accent);
}

.td-editor-cap {
  position: absolute;
  bottom: 0;
  padding: 0 1ch;
  background: var(--td-bg);
  line-height: 1;
  transform: translateY(50%);
  white-space: nowrap;
}

.td-editor-left { left: 2ch; }

.td-activity {
  display: inline-flex;
  gap: 1ch;
  align-items: center;
}

.td-activity[hidden],
.td-editor-left[hidden],
.td-footer-row[hidden] {
  display: none;
}

.td-spinner { color: var(--td-accent); }
.td-shimmer { color: var(--td-muted); }
.td-shimmer-ch[data-s='0'] { color: var(--td-accent); font-weight: 700; }
.td-shimmer-ch[data-s='1'] { color: var(--td-accent); }
.td-shimmer-ch[data-s='2'] { color: var(--td-text); }

.td-access {
  right: 1ch;
  color: var(--td-success);
}

.td-input {
  min-height: 28px;
  padding: 7px 1ch 6px;
}

.td-caret {
  display: inline-block;
  width: 6px;
  height: 1.15em;
  vertical-align: -2px;
  background: var(--td-text);
  animation: blink 1s steps(1) infinite;
}

.td-placeholder {
  margin-left: 2px;
  color: var(--td-dim);
}

/* Two-line footer mirrors renderStatusFooter in chrome/status-line.ts. */
.td-footer {
  display: grid;
  gap: 2px;
  padding: 6px 2ch 0;
  color: var(--td-dim);
}

.td-footer-row {
  display: flex;
  gap: 12px;
  justify-content: space-between;
  white-space: nowrap;
}

.td-f-right {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.td-f-text { color: var(--td-text); }
.td-f-muted { color: var(--td-muted); }
.td-f-sep { color: var(--td-dim); }
.td-f-accent { color: var(--td-accent); }
.td-f-token { color: var(--td-token); }
.td-f-positive { color: var(--td-success); }

@keyframes blink {
  50% { opacity: 0; }
}

@media (max-width: 640px) {
  .terminal-demo {
    width: min(520px, 100%);
    font-size: 9.5px;
  }

  .td-screen { padding: 8px 10px 9px; }
  .td-logo { width: 92px; }
  .td-header { gap: 2ch; }
  .td-transcript { min-height: 136px; padding: 12px 0 14px; }
}

@media (max-width: 430px) {
  .td-chrome { height: 24px; }
  .td-logo { width: 78px; }
  .td-transcript { min-height: 124px; padding: 10px 0 12px; }
  .td-footer { padding-inline: 1ch; }
  .td-footer-row:first-child .td-f-right,
  .td-footer-row[data-td-telemetry-settled] .td-f-right { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .td-caret { animation: none; }
}
</style>
