---
interface Props {
  version: string
}

const { version } = Astro.props
const samplePrompt = 'Hello, Oh My DSH!'
const thinking = 'The user is saying hello. This is a casual greeting, so no tools are needed.'
const answer = "Hello! Welcome to Oh My DSH. Tell me what you’d like to build, fix, or explore."
// Braille glyphs are missing from most monospace fonts, so browsers fall back
// to a wider font. Render each character in a fixed-width cell so fallback
// glyph metrics cannot stretch the logo.
const logoRows = [
  '         ⢀⣀  ⢀⡀',
  '⢀⣤⣶⣿⣿⣿⣿⣿⣿⣿⣧⣄⡀⢻⣿⣷⣶⣶⣶⡿',
  '⣿⡟⠛⠛⠛⠿⢿⣿⣿⣿⣿⡿⢿⣷⣾⣿⣿⠉⠉',
  '⢻⣿⣄⡀  ⢀⠈⠛⢿⣿⣿⣶⣿⣿⡿⠃',
  ' ⠙⠻⢿⣶⣦⣼⣿⣷⣦⣭⣿⠿⣿⣷⠦',
  '     ⠉⠉⠉⠉⠉⠁',
].map((row, rowIndex) =>
  Array.from(row).map((character, column) => {
    const progress = Math.min(1, (column + rowIndex * 0.7) / 23)
    const hue = Math.round(292 - progress * 108)
    return { character: character === ' ' ? '\u00a0' : character, color: `hsl(${hue} 84% 61%)` }
  })
)
---

<div class="terminal-demo" data-terminal-demo aria-hidden="true">
  <div class="td-chrome">
    <i class="td-dot td-dot-red"></i>
    <i class="td-dot td-dot-yellow"></i>
    <i class="td-dot td-dot-green"></i>
  </div>
  <div class="td-screen">
    <section class="td-header">
      <div class="td-logo">
        {
          logoRows.map((cells) => (
            <span class="td-logo-row">
              {cells.map((cell) => <i class="td-logo-cell" style={{ color: cell.color }}>{cell.character}</i>)}
            </span>
          ))
        }
      </div>
      <div class="td-wordmark">
        <span class="td-name">oh-my-dsh <em>v{version}</em></span>
        <span class="td-slogan">Into the Unknown</span>
      </div>
    </section>
    <p class="td-tips">
      <b>Tips:</b>
      <span><kbd>/</kbd> commands</span><i>·</i>
      <span><kbd>@</kbd> files</span><i>·</i>
      <span><kbd>!</kbd> shell</span><i>·</i>
      <span><kbd>/help</kbd> all shortcuts</span>
    </p>
    <div class="td-transcript">
      <div class="td-user-message" data-td-user hidden></div>
      <div class="td-response" data-td-response></div>
    </div>
    <div class="td-editor">
      <div class="td-rule">
        <span class="td-editor-label">🐳</span>
        <span class="td-access">full access</span>
      </div>
      <div class="td-input">
        <span data-td-prompt></span><i class="td-caret" data-td-caret></i>
      </div>
      <div class="td-rule td-rule-foot"></div>
    </div>
    <footer class="td-footer">
      <div class="td-footer-row">
        <span><b>deepseek-flash</b> · <em>max</em> · <mark>standard</mark></span>
        <span>~/oh-my-dsh&nbsp; · &nbsp;main</span>
      </div>
      <div class="td-footer-row">
        <span>Ctx <mark>1%</mark> · <b>10.1k/1M</b> · Cache <em>99%</em></span>
        <span>TTFT <em>0.9s</em> · <em>97 tok/s</em> · <b>9.6K</b> in · <b>395</b> out</span>
      </div>
    </footer>
  </div>
</div>

<script
  is:inline
  define:vars={{ samplePrompt, thinking, answer }}
>
  const root = document.querySelector('[data-terminal-demo]')
  if (root) {
    const promptEl = root.querySelector('[data-td-prompt]')
    const userEl = root.querySelector('[data-td-user]')
    const responseEl = root.querySelector('[data-td-response]')
    const caretEl = root.querySelector('[data-td-caret]')
    const timers = []
    let stopped = false

    const later = (fn, delay) => {
      const id = setTimeout(() => {
        if (!stopped) fn()
      }, delay)
      timers.push(id)
    }

    const showSettled = () => {
      promptEl.textContent = ''
      userEl.hidden = false
      userEl.textContent = samplePrompt
      responseEl.innerHTML =
        `<div class="td-muted">${thinking}</div><div class="td-answer">${answer}</div>`
      caretEl.hidden = true
    }

    const typePrompt = (index = 0) => {
      if (index >= samplePrompt.length) {
        later(runTurn, 450)
        return
      }
      promptEl.textContent += samplePrompt[index]
      later(() => typePrompt(index + 1), 34)
    }

    const runTurn = () => {
      userEl.hidden = false
      userEl.textContent = promptEl.textContent
      promptEl.textContent = ''
      responseEl.innerHTML = `<div class="td-muted">${thinking}</div>`
      later(() => {
        responseEl.insertAdjacentHTML('beforeend', `<div class="td-answer">${answer}</div>`)
      }, 850)
      later(resetDemo, 6200)
    }

    const resetDemo = () => {
      promptEl.textContent = ''
      userEl.hidden = true
      userEl.textContent = ''
      responseEl.innerHTML = ''
      later(() => typePrompt(), 650)
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      showSettled()
    } else if ('requestIdleCallback' in window) {
      requestIdleCallback(() => later(() => typePrompt(), 400), { timeout: 2500 })
    } else {
      later(() => typePrompt(), 850)
    }
  }
</script>

<style>
.terminal-demo {
  width: min(760px, 100%);
  margin: 0 auto;
  overflow: hidden;
  color: #c8c7cc;
  background: #101016;
  border: 1px solid #20212b;
  border-radius: 17px;
  box-sizing: border-box;
  box-shadow: 0 26px 72px rgb(0 0 0 / 42%);
  font-family: 'SFMono-Regular', 'Cascadia Code', 'JetBrains Mono', ui-monospace, monospace;
  font-size: 10px;
  line-height: 1.45;
  text-align: left;
}

.td-chrome {
  display: flex;
  gap: 7px;
  align-items: center;
  height: 29px;
  padding: 0 11px;
  background: #101016;
}

.td-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.td-dot-red { background: #ff5f57; }
.td-dot-yellow { background: #febc2e; }
.td-dot-green { background: #28c840; }

.td-screen { padding: 12px 13px 10px; }

/*
 * The header is the lockup the TUI draws: the mark, then the wordmark and the
 * slogan centred against it, then one hint line. It is deliberately not a card
 * with a border, a tips table and a session list — that panel was thirteen rows
 * of a reader's first screen, and it is gone from the product too.
 * Mirror of `renderWelcome` in packages/tui/omdsh-tui/src/chrome/box.ts.
 */
.td-header {
  display: flex;
  gap: 3ch;
  align-items: center;
  padding: 6px 0 0;
}

.td-logo {
  display: grid;
  font-family: Menlo, Monaco, 'DejaVu Sans Mono', monospace;
  font-size: 9.5px;
  line-height: 1;
}

.td-logo-row {
  display: grid;
  height: 1.45em;
  grid-auto-columns: 0.52em;
  grid-auto-flow: column;
  justify-content: start;
}

.td-logo-cell {
  display: block;
  width: 0.52em;
  overflow: visible;
  font-style: normal;
  text-align: center;
  transform: scale(0.84, 1.55);
  transform-origin: center;
}

.td-wordmark {
  display: grid;
  gap: 1px;
  min-width: 0;
}

.td-name {
  color: #d3d2d6;
  font-weight: 700;
}

.td-name em {
  color: #6d6f79;
  font-style: normal;
  font-weight: 400;
}

.td-slogan { color: #8a8c96; }

.td-tips {
  display: flex;
  margin: 10px 0 0;
  gap: 0.5ch;
  flex-wrap: wrap;
  color: #8a8c96;
}

.td-tips b {
  margin-right: 0.5ch;
  color: #f0a818;
}

.td-tips kbd {
  color: #6d6f79;
  font: inherit;
}

.td-tips i {
  color: #565863;
  font-style: normal;
}

.td-transcript {
  min-height: 155px;
  padding: 18px 0 20px;
}

.td-user-message {
  margin-bottom: 14px;
  padding: 14px 12px;
  color: #d6d4d7;
  background: #191613;
}

.td-response {
  display: grid;
  gap: 10px;
  padding: 0 13px;
}

.td-response :global(.td-muted) { color: #6b7280; }
.td-response :global(.td-answer) { color: #d7d6d9; }

/*
 * The composer is ruled above and below, not boxed: the label sits inside the
 * top rule and the Access badge closes it on the right. Mirror of
 * `renderEditor` in the same file.
 */
.td-editor {
  position: relative;
  color: #dedde0;
}

.td-rule {
  position: relative;
  height: 0;
  border-top: 1px solid #363843;
}

.td-rule-foot { border-top-color: #363843; }

.td-editor-label,
.td-access {
  position: absolute;
  bottom: 0;
  padding: 0 7px;
  background: #101016;
  line-height: 1;
  transform: translateY(50%);
  white-space: nowrap;
}

/* The mark is a glyph in the rule, so it needs its own size: the terminal draws
   it at text size, but 10px leaves an emoji with no room for its own detail. */
.td-editor-label {
  left: 12px;
  font-size: 13px;
}

.td-access {
  right: 6px;
  color: #ff5364;
}

.td-input {
  min-height: 24px;
  padding: 5px 11px 6px;
}

.td-caret {
  display: inline-block;
  width: 5px;
  height: 1.15em;
  margin-left: 2px;
  vertical-align: -2px;
  background: #aeb0ba;
  animation: blink 1s steps(1) infinite;
}

.td-footer {
  display: grid;
  gap: 2px;
  padding: 7px 8px 0;
  color: #696b76;
}

.td-footer-row {
  display: flex;
  gap: 12px;
  justify-content: space-between;
  white-space: nowrap;
}

.td-footer b,
.td-footer em,
.td-footer mark {
  font: inherit;
  background: none;
}

.td-footer b { color: #e5a912; }
.td-footer em { color: #60c878; }
.td-footer mark { color: #ad77df; }

@keyframes blink {
  50% { opacity: 0; }
}

@media (max-width: 640px) {
  .terminal-demo {
    width: min(520px, 100%);
    font-size: 8.5px;
  }

  .td-screen { padding: 10px; }
  .td-header { gap: 2ch; }
  .td-transcript { min-height: 132px; padding-bottom: 18px; }
  .td-footer-row span:last-child { overflow: hidden; text-overflow: ellipsis; }
}

@media (max-width: 430px) {
  .td-chrome { height: 24px; }
  .td-logo { font-size: 7px; }
  /* The hint line keeps its lead and its first two hints; the rest is what a
     narrow terminal drops too. */
  .td-tips i:nth-of-type(n + 3),
  .td-tips span:nth-of-type(n + 3) { display: none; }
  .td-transcript { min-height: 126px; padding: 14px 0 16px; }
  .td-response { gap: 7px; padding-inline: 8px; }
  .td-footer-row:first-child span:last-child,
  .td-footer-row:last-child span:first-child { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .td-caret { animation: none; }
}
</style>
