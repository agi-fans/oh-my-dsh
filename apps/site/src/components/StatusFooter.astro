---
import type { Locale } from '../i18n'

interface Props {
  locale: Locale
  path: string
  words?: number
}

const { locale, path, words = 0 } = Astro.props
const tokens = Math.round(words * 1.3)
const tokenLabel = tokens >= 1000 ? `${(tokens / 1000).toFixed(1)}k` : String(tokens)
const wordUnit = locale === 'zh' ? '字' : 'words'
const slogan = locale === 'zh' ? '探索未至之境' : 'Into the Unknown'
const langLabel = locale === 'zh' ? 'zh-CN' : 'en-US'
---

<div class="status-footer" data-pagefind-ignore>
  <div class="row">
    <span><span class="sf-brand">🐳 Oh My DSH</span><span class="sf-path"> · {path}</span></span>
    <span>{langLabel}</span>
  </div>
  <div class="row">
    <span>
      <span class="sf-ctx" data-sf-ctx>Ctx 0%</span>{
        words > 0 && <span> · ≈{tokenLabel} tokens / {words} {wordUnit}</span>
      }
    </span>
    <span class="sf-slogan">{slogan}</span>
  </div>
</div>

<script>
  const ctx = document.querySelector('[data-sf-ctx]')
  if (ctx) {
    let ticking = false
    const update = () => {
      ticking = false
      const max = document.documentElement.scrollHeight - window.innerHeight
      const pct = max <= 0 ? 100 : Math.min(100, Math.round((window.scrollY / max) * 100))
      ctx.textContent = `Ctx ${pct}%`
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true
          requestAnimationFrame(update)
        }
      },
      { passive: true },
    )
    update()
  }
</script>
