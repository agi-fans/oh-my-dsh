---
import TerminalDemo from './TerminalDemo.astro'
import { homeCopy } from '../home'
import { repoUrl, localizedPath, type Locale } from '../i18n'
import { docsHref } from '../nav'
import { omdshVersion } from '../version'
import '../styles/home.css'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = homeCopy[locale]
const installCommand = 'npm install --global @agi-fans/oh-my-dsh'
---

<section class="hero">
  <div>
    <h1 class="hero-name">Oh My <span class="grad">DSH</span></h1>
    <p class="hero-slogan">{copy.heroText}</p>
    <p class="hero-tagline">{copy.tagline}</p>
    <div class="btn-row">
      <a class="btn primary" href={docsHref('tutorials', locale)}>{copy.actionPrimary}</a>
      <a class="btn" href={repoUrl}>{copy.actionAlt}</a>
    </div>
  </div>
  <div class="hero-demo">
    <TerminalDemo version={omdshVersion} />
  </div>
</section>

<section class="install">
  <h2 class="section-heading">{copy.installHeading}</h2>
  <div class="composer-box">
    <span class="cb-label">🐳</span>
    <span class="cb-access">full access</span>
    <div class="composer-command">
      <span class="prompt-sign">$</span>
      <code>{installCommand}</code>
      <button class="copy-btn" type="button" data-copy={installCommand}>copy</button>
    </div>
  </div>
  <p class="install-note">{copy.installNote}</p>
  <p class="keyboard-hint">{copy.keyboardHint}</p>
</section>

<section class="features">
  <h2 class="section-heading">{copy.featuresHeading}</h2>
  <div class="features-grid">
    {
      copy.features.map((feature) => (
        <a class="tool-card" href={localizedPath(feature.href, locale)}>
          <span class="tc-head">
            <span class="tc-dot" />
            <span class="tc-handle">{feature.handle}</span>
            <span class="tc-arrow" aria-hidden="true">↗</span>
          </span>
          <span class="tc-body">
            <span class="tc-title">{feature.title}</span>
            <span class="tc-details">{feature.details}</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<section class="why">
  <h2 class="section-heading">{copy.whyHeading}</h2>
  <div class="why-grid">
    {
      copy.why.map((item) => (
        <a class="why-card" href={localizedPath(item.href, locale)}>
          <span class="wc-handle">{item.handle}</span>
          <span class="wc-title">{item.title}</span>
          <span class="wc-details">{item.details}</span>
        </a>
      ))
    }
  </div>
</section>

<section class="proof">
  <h2 class="section-heading">{copy.proofHeading}</h2>
  <div class="proof-grid">
    {
      copy.proof.map((stat) => (
        <div class="proof-stat">
          <span class="ps-value">{stat.value}</span>
          <span class="ps-label">{stat.label}</span>
        </div>
      ))
    }
  </div>
  <p class="proof-note">
    {copy.proofNote} <a href={localizedPath(copy.proofHref, locale)}>{copy.proofLink}</a>
  </p>
</section>

<script>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy') ?? ''
      try {
        await navigator.clipboard.writeText(text)
        btn.textContent = 'copied'
        setTimeout(() => {
          btn.textContent = 'copy'
        }, 1600)
      } catch {
        btn.textContent = text
      }
    })
  })
</script>
