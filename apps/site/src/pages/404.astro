---
import Site from '../layouts/Site.astro'
---

<Site locale="en" path="/404" title="404" index={false}>
  <div class="page-shell" style="padding: 110px 24px 140px; text-align: center">
    <h1 style="margin: 0 0 14px; font-family: var(--font-mono); font-size: 42px">
      <span style="color: var(--brand-bright)">$</span> 404
    </h1>
    <p style="margin: 0 0 30px; color: var(--ink-dim)">Page not found · 页面不存在</p>
    <div class="btn-row" style="justify-content: center">
      <a class="btn primary" href="/docs/tutorials">Docs</a>
      <a class="btn" href="/zh/">中文</a>
    </div>
  </div>
</Site>
