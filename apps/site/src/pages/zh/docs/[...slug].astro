---
import { getCollection, render } from 'astro:content'
import Docs from '../../../layouts/Docs.astro'

export async function getStaticPaths() {
  const entries = await getCollection('zh')
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const title = headings.find((h) => h.depth === 1)?.text ?? entry.id
const body = entry.body ?? ''
const latin = body.match(/[A-Za-z0-9_'-]+/g)?.length ?? 0
const cjk = body.match(/[一-鿿]/g)?.length ?? 0
const words = latin + cjk
---

<Docs
  locale="zh"
  path={`/zh/docs/${entry.id}`}
  slug={entry.id}
  title={title}
  description={entry.data.description}
  words={words}
  headings={headings}
>
  <Content />
</Docs>
