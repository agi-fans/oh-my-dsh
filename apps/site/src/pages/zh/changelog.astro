---
import { getEntry, render } from 'astro:content'
import Site from '../../layouts/Site.astro'
import { changelogDescriptions } from '../../i18n'
import CodeCopy from '../../components/CodeCopy.astro'
import '../../styles/docs.css'

// The changelog is English-only; both locales render the same source.
const entry = await getEntry('changelog', 'changelog')
if (!entry) throw new Error('Missing the repository-root CHANGELOG.md entry.')
const { Content } = await render(entry)
const words = (entry.body ?? '').match(/[A-Za-z0-9_'-]+/g)?.length ?? 0
---

<Site locale="zh" path="/zh/changelog" title="更新日志" description={changelogDescriptions.zh} words={words}>
  <article class="doc-plain doc-body" data-pagefind-body>
    <Content />
  </article>
  <CodeCopy />
</Site>
