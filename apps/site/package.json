{
  "name": "@agi-fans/oh-my-dsh-site",
  "private": true,
  "description": "Public Astro site for oh-my-dsh; content/ is the documentation source of truth.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && cp dist/sitemap-index.xml dist/sitemap.xml",
    "preview": "astro preview",
    "test": "vitest run src",
    "typecheck": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "astro": "^5.13.2",
    "pagefind": "^1.3.0",
    "rehype-slug": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
